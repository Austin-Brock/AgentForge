# Copy this file to .env and fill in your key. .env is gitignored.
OPENAI_API_KEY=

# The model used for every role. Run `python -m agentforge models` to see the IDs your key can use.
AGENTFORGE_MODEL=gpt-5.4-nano

# The model that reviews failures and proposes lessons. A stronger one diagnoses better.
AGENTFORGE_REFLECTOR_MODEL=gpt-5.4-mini
